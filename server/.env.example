POSTGRES_PASSWORD=generate-a-long-url-safe-random-value
INITIAL_EMAIL=you@example.com
INITIAL_PASSWORD=generate-a-separate-long-random-password
ZIPLINE_URL=https://your-zipline.example.com
ZIPLINE_TOKEN=dedicated-zipline-user-token
SERVICE_FQDN_API_8080=https://your-scrapnote-api.example.com

# 비밀번호 복구 메일. 사용자명/비밀번호의 특수문자는 URL 인코딩한다.
SMTP_URL=smtps://username:password@smtp.example.com:465
SMTP_FROM=noreply@example.com
